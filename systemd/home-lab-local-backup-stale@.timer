[Unit]
Description=Periodic Home Lab local second-copy stale-state check (%i)
Documentation=https://github.com/jaustinanderson/home-server-lab/blob/main/systemd/README.md

[Timer]
OnBootSec=10m
OnUnitActiveSec=6h
RandomizedDelaySec=5m
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
